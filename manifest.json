{
  "manifest_version": 3,
  "name": "Better GH",
  "version": "0.1.0",
  "description": "View images and videos in GitHub issues, pull requests, and discussions in a full-screen viewer instead of a new tab.",
  "minimum_chrome_version": "140",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["downloads"],
  "host_permissions": [
    "https://github.com/*",
    "https://*.githubusercontent.com/*",
    "https://github-production-user-asset-6210df.s3.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/icons.js", "src/viewer.js", "src/content.js"],
      "css": ["src/viewer.css"]
    }
  ]
}
